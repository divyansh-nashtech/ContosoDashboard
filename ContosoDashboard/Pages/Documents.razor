@page "/documents"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Documents - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>Documents</h1>
            <p class="text-muted">Upload, organize, and find your work documents.</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowUploadForm">
                <i class="bi bi-cloud-arrow-up"></i> Upload Document
            </button>
        </div>
    </div>

    @if (statusMessage != null)
    {
        <div class="alert @(uploadFailed ? "alert-danger" : "alert-success") alert-dismissible">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    @if (showUploadForm)
    {
        <div class="card mb-4">
            <div class="card-header">Upload a document</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">File <span class="text-danger">*</span></label>
                        <InputFile @key="inputFileKey" class="form-control" OnChange="OnFileSelected" />
                        <small class="text-muted">
                            Up to 25 MB. PDF, Word, Excel, PowerPoint, text, JPEG, and PNG files.
                        </small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Title <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="title" maxlength="255" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="category">
                            <option value="">Select a category</option>
                            @foreach (var option in DocumentCategories.All)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Project</label>
                        <select class="form-select" @bind="selectedProjectId">
                            <option value="0">None (personal document)</option>
                            @foreach (var project in myProjects)
                            {
                                <option value="@project.ProjectId">@project.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tags</label>
                        <input class="form-control" @bind="tags" maxlength="500" placeholder="budget, q3" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="2" @bind="description" maxlength="2000"></textarea>
                    </div>
                </div>

                @if (isUploading)
                {
                    <div class="progress mt-3">
                        <div class="progress-bar progress-bar-striped progress-bar-animated w-100">
                            Uploading @selectedFileName...
                        </div>
                    </div>
                }

                <div class="mt-3">
                    <button class="btn btn-primary" @onclick="UploadAsync" disabled="@(isUploading || selectedFile == null)">
                        Upload
                    </button>
                    <button class="btn btn-secondary" @onclick="CancelUpload" disabled="@isUploading">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label class="form-label">Search</label>
            <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Title, tags, uploader" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Category</label>
            <select class="form-select" @bind="filterCategory">
                <option value="">All</option>
                @foreach (var option in DocumentCategories.All)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Project</label>
            <select class="form-select" @bind="filterProjectId">
                <option value="0">All</option>
                @foreach (var project in myProjects)
                {
                    <option value="@project.ProjectId">@project.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Uploaded from</label>
            <input type="date" class="form-control" @bind="filterFrom" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Uploaded to</label>
            <input type="date" class="form-control" @bind="filterTo" />
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button class="btn btn-secondary w-100" @onclick="ApplyFilters">Apply</button>
        </div>
    </div>

    @if (documents == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (documents.Count == 0)
    {
        <div class="alert alert-info">
            No documents yet. Select <strong>Upload Document</strong> to add your first one.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th role="button" @onclick='() => SortBy("Title")'>Title</th>
                        <th role="button" @onclick='() => SortBy("Category")'>Category</th>
                        <th>Project</th>
                        <th role="button" @onclick='() => SortBy("FileSizeBytes")'>Size</th>
                        <th>Type</th>
                        <th role="button" @onclick='() => SortBy("UploadedDate")'>Uploaded</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var document in documents)
                    {
                        <tr>
                            <td>
                                <strong>@document.Title</strong>
                                <br />
                                <small class="text-muted">@document.FileName</small>
                                @if (!string.IsNullOrEmpty(document.Tags))
                                {
                                    <br />
                                    <small class="text-muted"><i class="bi bi-tags"></i> @document.Tags</small>
                                }
                            </td>
                            <td><span class="badge bg-secondary">@document.Category</span></td>
                            <td>
                                @if (document.Project != null)
                                {
                                    <a href="/projects/@document.ProjectId">@document.Project.Name</a>
                                }
                                else
                                {
                                    <span class="text-muted">Personal</span>
                                }
                            </td>
                            <td>@document.FileSizeDisplay</td>
                            <td><small class="text-muted">@document.ContentType</small></td>
                            <td>@document.UploadedDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-outline-primary"
                                   href="/api/documents/@document.DocumentId/download">
                                    <i class="bi bi-download"></i>
                                </a>
                                @if (IsPreviewable(document.ContentType))
                                {
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="/api/documents/@document.DocumentId/preview" target="_blank">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">@totalCount document(s)</small>
            <div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                    Previous
                </button>
                <span class="mx-2">Page @currentPage of @TotalPages</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">
                    Next
                </button>
            </div>
        </div>
    }
</div>

@code {
    private const int PageSize = 25;
    private static readonly string[] PreviewableTypes = { "application/pdf", "image/jpeg", "image/png" };

    private IReadOnlyList<Document>? documents;
    private List<Project> myProjects = new();
    private int totalCount;
    private int currentPage = 1;
    private int currentUserId;

    private bool showUploadForm;
    private bool isUploading;
    private bool uploadFailed;
    private string? statusMessage;

    private IBrowserFile? selectedFile;
    private string selectedFileName = string.Empty;
    private int inputFileKey;

    private string title = string.Empty;
    private string description = string.Empty;
    private string category = string.Empty;
    private string tags = string.Empty;
    private int selectedProjectId;

    private string searchTerm = string.Empty;
    private string filterCategory = string.Empty;
    private int filterProjectId;
    private DateTime? filterFrom;
    private DateTime? filterTo;
    private string sortBy = "UploadedDate";
    private bool sortDescending = true;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier);

        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            myProjects = await ProjectService.GetUserProjectsAsync(currentUserId);
            await LoadDocuments();
        }
    }

    private async Task LoadDocuments()
    {
        var query = new DocumentQuery(
            SearchTerm: string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
            Category: string.IsNullOrWhiteSpace(filterCategory) ? null : filterCategory,
            ProjectId: filterProjectId == 0 ? null : filterProjectId,
            UploadedFrom: filterFrom,
            UploadedTo: filterTo,
            SortBy: sortBy,
            SortDescending: sortDescending,
            Page: currentPage,
            PageSize: PageSize);

        var result = string.IsNullOrWhiteSpace(searchTerm)
            ? await DocumentService.GetMyDocumentsAsync(currentUserId, query)
            : await DocumentService.SearchAsync(currentUserId, query);

        documents = result.Items;
        totalCount = result.TotalCount;
    }

    private void ShowUploadForm()
    {
        showUploadForm = true;
        statusMessage = null;
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;

        if (string.IsNullOrWhiteSpace(title))
        {
            title = Path.GetFileNameWithoutExtension(e.File.Name);
        }
    }

    private async Task UploadAsync()
    {
        if (selectedFile == null)
        {
            return;
        }

        isUploading = true;
        statusMessage = null;

        // Read the file metadata and contents before any re-render disposes the browser
        // file stream, then release the reference so the input can be reused.
        var fileName = selectedFile.Name;
        var fileSize = selectedFile.Size;
        var contentType = selectedFile.ContentType;

        try
        {
            using var content = new MemoryStream();

            await using (var stream = selectedFile.OpenReadStream(DocumentLimits.MaxFileSizeBytes))
            {
                await stream.CopyToAsync(content);
            }

            content.Position = 0;
            selectedFile = null;

            var request = new DocumentUploadRequest(
                title,
                description,
                category,
                tags,
                selectedProjectId == 0 ? null : selectedProjectId,
                fileName,
                contentType,
                fileSize,
                content);

            var result = await DocumentService.UploadAsync(request, currentUserId);

            uploadFailed = !result.Succeeded;
            statusMessage = result.Succeeded
                ? $"\"{result.Document!.Title}\" was uploaded."
                : result.Error;

            if (result.Succeeded)
            {
                ResetUploadForm();
                currentPage = 1;
                await LoadDocuments();
            }
        }
        catch (IOException)
        {
            uploadFailed = true;
            statusMessage = "The file exceeds the 25 MB limit.";
        }
        finally
        {
            isUploading = false;
            inputFileKey++;
        }
    }

    private void CancelUpload()
    {
        ResetUploadForm();
        showUploadForm = false;
    }

    private void ResetUploadForm()
    {
        selectedFile = null;
        selectedFileName = string.Empty;
        title = string.Empty;
        description = string.Empty;
        category = string.Empty;
        tags = string.Empty;
        selectedProjectId = 0;
        inputFileKey++;
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadDocuments();
    }

    private async Task SortBy(string column)
    {
        sortDescending = sortBy == column ? !sortDescending : true;
        sortBy = column;
        await LoadDocuments();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadDocuments();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
            await LoadDocuments();
        }
    }

    private static bool IsPreviewable(string contentType) =>
        PreviewableTypes.Contains(contentType, StringComparer.OrdinalIgnoreCase);
}
